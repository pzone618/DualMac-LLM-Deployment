# Copy to config/cluster.env on both Macs; this file is sourced by Bash.
# No spaces around "=". The two Macs use the same directory layout.
M4_IP=10.77.0.1
M6_IP=10.77.0.2
M6_USER=CHANGE_ME
RPC_PORT=50052
M4_LOCAL_PORT=8081
M6_LOCAL_PORT=8082
DISTRIBUTED_PORT=8083
# IMPORTANT: pin the SAME full llama.cpp commit on both Macs after first M4 bootstrap.
LLAMA_CPP_REF=master
# Independent M4 model
MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF
MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
# Independent M6 model (can differ from M4)
M6_MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF
M6_MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
# Shared distributed GGUF must exist on M4. For shards, set the first shard path.
DISTRIBUTED_MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF
DISTRIBUTED_MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
CTX_SIZE=4096
# Public model download source: official | mirror | auto (tries official, then mirror)
# No HF token is sent to hf-mirror.com by this bundle.
HF_SOURCE=auto
