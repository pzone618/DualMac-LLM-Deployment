# Copy to config/cluster.env on BOTH Macs, edit M6_USER and LLAMA_CPP_REF.
# File is sourced by Bash; values must use shell syntax (no spaces around '=').
M4_IP=10.77.0.1
M6_IP=10.77.0.2
M6_USER=CHANGE_ME
RPC_PORT=50052
M4_LOCAL_PORT=8081
M6_LOCAL_PORT=8082
DISTRIBUTED_PORT=8083
# Pin the SAME llama.cpp commit on both devices after an initial git clone.
# Use 'master' only for first-time setup; switch to a full commit SHA afterwards.
LLAMA_CPP_REF=master
# Verified small test model at Hugging Face
MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF
MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
# Defaults to model above; later change for larger distributed GGUF.
DISTRIBUTED_MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF
DISTRIBUTED_MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
CTX_SIZE=4096
