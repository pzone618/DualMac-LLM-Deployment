# macOS and editor temporary files
.DS_Store
._*
*~
*.swp
*.swo

# Python environments and generated caches
/.venv/
/.venv-download/
/.venv-download.backup.*/
/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Machine-specific settings and credentials (keep example configuration)
/config/cluster.env
.env
.env.*
!.env.example
!.env.*.example

# Model weights, caches and resumable download state
/models/
/.download-state/
/.cache/
*.gguf
*.safetensors
*.aria2
*.incomplete
*.part
*.crdownload
*.source.json

# Local runtime output and machine-specific audit reports
/logs/
*.log
*.pid
/docs/*-integrity-audit.json

# llama.cpp checkout and build output (cloned under ~/AI, guard against in-repo copies)
/llama.cpp/
/build/
*.o
*.a
*.dylib
CMakeCache.txt
CMakeFiles/

# Hidden per-model source manifests and download leftovers
.*.source.json
*.aria2.tmp
*.downloading
*.gguf.*
/.hf-cache/
.huggingface/

# Machine-specific: external disk model dirs and cluster state
/AI/
/Volumes/
/config/cluster.env.local
/config/*.local
*.bak
*.orig

# Local tool settings (keep shared project settings if any)
/.claude/settings.local.json
/.claude/projects/
.vscode/*
!.vscode/extensions.json
.idea/

# Source archives (llama.cpp zip is unpacked to ~/AI/llama.cpp, never committed)
*.zip
*.tgz
*.tar.gz
*.bundle
